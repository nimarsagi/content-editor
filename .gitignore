__pycache__/
*.pyc

# Everything the tool produces: the run trail in output/runs/, the calibrated
# audio in output/audio/. Worth reading, not worth committing — regenerated by
# re-running, and it holds full-size copies of your footage.
output/

# The synthetic export the end-to-end check runs on. Generated by
# tools/make_fixture_video.py in a few seconds — a binary that can be rebuilt
# from the script beside it does not belong in the history.
tools/fixtures/

# Remotion
node_modules/
remotion/node_modules/
remotion/.remotion/

# Source videos staged for the bundler, one per run. The fonts beside them
# ARE source and stay tracked.
remotion/public/*.mp4
remotion/public/*.mov

# Videos you drop in input/ to be captioned. The folder is tracked, its
# contents are not — they are your footage.
input/*
!input/.gitkeep

# Generated from public/fonts/Inter-SemiBold.ttf at render time.
remotion/src/font-data.ts
